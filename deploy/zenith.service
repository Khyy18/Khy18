[Unit]
Description=Zenith-Control Ultimate trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zenith
Group=zenith
WorkingDirectory=/opt/zenith
EnvironmentFile=/opt/zenith/.env
ExecStart=/opt/zenith/.venv/bin/python /opt/zenith/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
