# Combo-Bot (Funding + Grid + Momentum) — шаблон .env
# Скопируйте в .env и заполните.

# ─── Telegram (обязательно) ───────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Режим ────────────────────────────────────────────────────────────
IS_TESTNET=true
DRY_RUN=false
ARB_EXECUTOR_ENABLED=0

# ─── Капитал и аллокация ──────────────────────────────────────────────
TOTAL_CAPITAL_USDT=550
ALLOC_FUNDING_PCT=0.50
ALLOC_GRID_PCT=0.30
ALLOC_MOMENTUM_PCT=0.20
GLOBAL_MAX_DRAWDOWN_PCT=0.15

# ─── Grid-бот ─────────────────────────────────────────────────────────
GRID_ENABLED=true
GRID_EXCHANGE=bybit
GRID_SYMBOLS=BTCUSDT,ETHUSDT
GRID_LEVELS=10
GRID_STEP_PCT=0.003
GRID_LEVERAGE=1
GRID_REBALANCE_INTERVAL_SEC=300

# ─── Momentum ─────────────────────────────────────────────────────────
MOMENTUM_ENABLED=true
MOMENTUM_EXCHANGE=bybit
MOMENTUM_SYMBOLS=BTCUSDT,ETHUSDT
MOMENTUM_EMA_FAST=9
MOMENTUM_EMA_SLOW=21
MOMENTUM_LEVERAGE=3
MOMENTUM_TIMEFRAME=15
MOMENTUM_STOP_LOSS_PCT=0.02
MOMENTUM_TAKE_PROFIT_PCT=0.04
MOMENTUM_TICK_INTERVAL_SEC=60
MOMENTUM_MAX_POSITIONS=2
MOMENTUM_MIN_ATR_PCT=0.005
MOMENTUM_TRAIL_ACTIVATE_PCT=0.02
MOMENTUM_TRAIL_DISTANCE_PCT=0.01

# ─── Биржевые ключи ───────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BINANCE_API_KEY=
BINANCE_API_SECRET=

GATE_API_KEY=
GATE_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

HTX_API_KEY=
HTX_API_SECRET=

BINGX_API_KEY=
BINGX_API_SECRET=

# ─── Funding-арб ──────────────────────────────────────────────────────
ARB_DAILY_LOSS_USDT=30
ARB_WEEKLY_LOSS_USDT=100

# ─── Persistence ──────────────────────────────────────────────────────
TRADES_DB_PATH=/app/data/trades.db
STATE_DB_PATH=/app/data/state.json

# ─── Дашборд ──────────────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
