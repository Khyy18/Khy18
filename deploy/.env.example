# Zenith Funding Arbitrage Bot — шаблон .env для деплоя.
# Скопируйте в deploy/.env и заполните.

# Telegram (обязательно)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Включить торговлю.
ARB_EXECUTOR_ENABLED=0
DRY_RUN=false
IS_TESTNET=true

# Биржевые ключи (заполните те биржи, где хотите торговать).
BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BINANCE_API_KEY=
BINANCE_API_SECRET=

GATE_API_KEY=
GATE_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

HTX_API_KEY=
HTX_API_SECRET=

BINGX_API_KEY=
BINGX_API_SECRET=

# Killswitches.
ARB_DAILY_LOSS_USDT=30
ARB_WEEKLY_LOSS_USDT=100

# DB-путь внутри контейнера (volume).
TRADES_DB_PATH=/app/data/trades.db

# Дашборд.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
