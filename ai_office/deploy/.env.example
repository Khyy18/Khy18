# AI Office Docker Deployment - Environment Variables
# Скопируйте в .env и заполните реальными значениями.

# --- PostgreSQL ---
POSTGRES_DB=ai_office
POSTGRES_USER=ai_office
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://ai_office:changeme@postgres:5432/ai_office

# --- Telegram ---
TELEGRAM_APP_ID=your_telegram_app_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=123456789

# --- LLM Providers ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Порядок провайдеров (fallback chain)
LLM_PROVIDERS=openai,anthropic,groq
# Максимальное количество повторов на провайдер
LLM_MAX_RETRIES=3
# Дневной бюджет в USD
DAILY_BUDGET_USD=10.0
# Глобальный лимит запросов в минуту
GLOBAL_RPM_LIMIT=100
# Лимит запросов в минуту на агента
AGENT_RPM_LIMIT=20

# --- Proactive Scheduler ---
ENABLE_PROACTIVE=true
# Час ежедневного стендапа Alice (UTC)
STANDUP_HOUR=9
# День недельного отчёта Eva
WEEKLY_REPORT_DAY=monday
# Интервал проверки просроченных задач Leo (часы)
OVERDUE_CHECK_INTERVAL_HOURS=4
# Интервал health-check Nova (часы)
HEALTH_CHECK_INTERVAL_HOURS=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
