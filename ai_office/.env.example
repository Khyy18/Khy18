# =============================================================================
# AI Office - Пример файла переменных окружения
# Скопируйте в .env и заполните реальными значениями.
# ВНИМАНИЕ: никогда не коммитьте файл .env в репозиторий!
# =============================================================================

# --- LLM Провайдеры ---
# API ключ OpenAI (обязательно для работы агентов)
OPENAI_API_KEY=sk-...your-key-here...
# Модель OpenAI (по умолчанию: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# API ключ Anthropic (опционально, для fallback)
ANTHROPIC_API_KEY=""
# API ключ Groq (опционально, для fallback)
GROQ_API_KEY=""
# Порядок провайдеров через запятую (fallback chain)
LLM_PROVIDERS=openai,anthropic,groq
# Максимальное количество повторов на провайдер
LLM_MAX_RETRIES=3

# --- Rate Limiting и Бюджет ---
# Дневной бюджет в USD
DAILY_BUDGET_USD=10.0
# Глобальный лимит запросов в минуту
GLOBAL_RPM_LIMIT=100
# Лимит запросов в минуту на одного агента
AGENT_RPM_LIMIT=20
# Включить rate limiter (true/false)
ENABLE_RATE_LIMITER=true

# --- Логирование ---
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Формат логов: json или text
LOG_FORMAT=json

# --- Проактивный планировщик ---
# Включить проактивные задачи агентов (стендапы, отчёты, проверки)
ENABLE_PROACTIVE=true
# Час ежедневного стендапа Alice (UTC, 0-23)
STANDUP_HOUR=9
# День недельного отчёта Eva (monday, tuesday, ..., sunday)
WEEKLY_REPORT_DAY=monday
# Интервал проверки просроченных задач Leo (часы)
OVERDUE_CHECK_INTERVAL_HOURS=4
# Интервал health-check системы Nova (часы)
HEALTH_CHECK_INTERVAL_HOURS=1

# --- Telegram ---
# Telegram API ID (получить на https://my.telegram.org)
TELEGRAM_API_ID=0
# Telegram API Hash
TELEGRAM_API_HASH=""
# Токен бота от @BotFather (обязательно для Telegram-интеграции)
TELEGRAM_BOT_TOKEN=""
# ID целевого чата (числовой)
TARGET_CHAT_ID=0

# --- Интеграции ---
# GitHub Personal Access Token (для интеграции с GitHub)
GITHUB_TOKEN=""
# API ключ Linear (для синхронизации задач)
LINEAR_API_KEY=""
# Синхронизировать задачи в Linear (true/false)
SYNC_TO_LINEAR=false
# API ключ Notion
NOTION_API_KEY=""
# ID базы данных Notion
NOTION_DATABASE_ID=""
# Синхронизировать в Notion (true/false)
SYNC_TO_NOTION=false

# --- Голос/TTS ---
# Модель Whisper для транскрипции голосовых сообщений
WHISPER_MODEL=whisper-1
# Модель TTS для синтеза речи
TTS_MODEL=tts-1
# Отвечать голосовыми сообщениями (true/false)
VOICE_RESPONSES=false

# --- Аутентификация ---
# Пропуск Telegram-аутентификации (true для dev-режима)
SKIP_TELEGRAM_AUTH=true

# --- База данных ---
# URL подключения к базе данных
# Для локальной разработки (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./ai_office.db
# Для Docker/продакшена (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://ai_office:changeme@postgres:5432/ai_office

# --- Redis ---
# URL Redis (опционально, для кэширования)
REDIS_URL=""
