# ==================================================
# AI-Агентство: Конфигурация окружения
# ==================================================
# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# --------------------------------------------------
# Telegram
# --------------------------------------------------
# Токен клиентского бота (обязательно)
TELEGRAM_BOT_TOKEN=
# Токен админского бота (обязательно для admin_bot)
TELEGRAM_ADMIN_BOT_TOKEN=
# Telegram ID администратора (для уведомлений и доступа)
ADMIN_TELEGRAM_ID=0
# Юзернейм бота для deep links
BOT_USERNAME=
# ID канала для публикации кейсов
CHANNEL_ID=

# --------------------------------------------------
# OpenAI / LLM
# --------------------------------------------------
# Ключ OpenAI API (обязательно)
OPENAI_API_KEY=
# Модель по умолчанию
DEFAULT_MODEL=gpt-4o-mini
# Ключ Groq API (fallback LLM)
GROQ_API_KEY=

# --------------------------------------------------
# База данных
# --------------------------------------------------
# Путь к файлу SQLite
DATABASE_PATH=agency.db

# --------------------------------------------------
# YooKassa (платежи)
# --------------------------------------------------
# ID магазина YooKassa (обязательно)
YOOKASSA_SHOP_ID=
# Секретный ключ YooKassa (обязательно)
YOOKASSA_SECRET_KEY=
# Секрет вебхука
YOOKASSA_WEBHOOK_SECRET=

# --------------------------------------------------
# Telegram Stars (нативные платежи)
# --------------------------------------------------
# Курс конвертации: 1 Star = X рублей
STARS_TO_RUB_RATE=1.5

# --------------------------------------------------
# Веб-сервер (лендинг)
# --------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --------------------------------------------------
# REST API
# --------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --------------------------------------------------
# Подписки
# --------------------------------------------------
# Цена подписки BASIC (руб/мес)
SUBSCRIPTION_BASIC_PRICE=990
# Количество заказов в подписке BASIC
SUBSCRIPTION_BASIC_ORDERS=20
# Цена подписки PRO (руб/мес)
SUBSCRIPTION_PRO_PRICE=2490

# --------------------------------------------------
# Персона бота (white-label)
# --------------------------------------------------
# Имя бота-персоны
BOT_PERSONA_NAME=Алиса
# Приветственное сообщение
BOT_PERSONA_GREETING=Привет! Я Алиса, ваш персональный менеджер.

# --------------------------------------------------
# Реферальная система
# --------------------------------------------------
# Процент бонуса за реферала
REFERRAL_BONUS_PERCENT=10

# --------------------------------------------------
# Мониторинг и Sentry
# --------------------------------------------------
# DSN для Sentry (опционально, оставьте пустым для отключения)
SENTRY_DSN=

# --------------------------------------------------
# Логирование
# --------------------------------------------------
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Путь к файлу логов
LOG_FILE=logs/agency.log

# --------------------------------------------------
# Очередь заказов
# --------------------------------------------------
# Максимальный размер очереди
QUEUE_MAX_SIZE=100
# Количество воркеров обработки
QUEUE_WORKERS=3

# --------------------------------------------------
# Бэкапы
# --------------------------------------------------
# Директория для бэкапов
BACKUP_DIR=backups
# Количество хранимых бэкапов
BACKUP_KEEP_COUNT=7

# --------------------------------------------------
# Аналитика
# --------------------------------------------------
# Google Analytics ID (опционально)
GOOGLE_ANALYTICS_ID=
# Yandex Metrika ID (опционально)
YANDEX_METRIKA_ID=

# --------------------------------------------------
# Парсер лидов
# --------------------------------------------------
# Ключевые слова для парсинга Kwork
KWORK_KEYWORDS=копирайтинг,рерайт,SEO,перевод

# --------------------------------------------------
# Мульти-бот архитектура
# --------------------------------------------------
# JSON-строка с конфигурацией нишевых ботов
NICHE_BOTS=[]

# --------------------------------------------------
# Stripe (международные платежи)
# --------------------------------------------------
# Секретный ключ Stripe
STRIPE_SECRET_KEY=
# Секрет вебхука Stripe
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------
# NOWPayments (крипто-платежи)
# --------------------------------------------------
# API-ключ NOWPayments
NOWPAYMENTS_API_KEY=
# IPN-секрет NOWPayments
NOWPAYMENTS_IPN_SECRET=

# --------------------------------------------------
# Контент-ферма (автопостинг в каналы)
# --------------------------------------------------
# JSON-список каналов: [{"channel_id": "@chan", "niche": "business_tips", "schedule": [9, 15, 20]}]
CONTENT_FARM_CHANNELS=[]

# --------------------------------------------------
# White-label система
# --------------------------------------------------
# Включить загрузку white-label ботов из БД
WHITELABEL_ENABLED=False

# --------------------------------------------------
# Курс обмена USD/RUB
# --------------------------------------------------
# Курс конвертации USD в RUB для международных платежей
USD_TO_RUB_RATE=90.0
