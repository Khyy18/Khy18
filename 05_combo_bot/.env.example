# Combo-Bot (Funding + Grid + Momentum) — шаблон .env
# Скопируйте в .env и заполните.

# ─── Telegram (обязательно) ───────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Режим ────────────────────────────────────────────────────────────
IS_TESTNET=true
DRY_RUN=false
ARB_EXECUTOR_ENABLED=0

# ─── Капитал и аллокация ──────────────────────────────────────────────
TOTAL_CAPITAL_USDT=550
ALLOC_FUNDING_PCT=0.70
ALLOC_GRID_PCT=0.25
ALLOC_MOMENTUM_PCT=0.05
GLOBAL_MAX_DRAWDOWN_PCT=0.15

# ─── Grid-бот ─────────────────────────────────────────────────────────
GRID_ENABLED=true
GRID_EXCHANGE=bybit
# Altcoins (SOL, DOGE) дают в 3-5x больше grid-циклов из-за высокой волатильности
GRID_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT
GRID_LEVELS=12
GRID_STEP_PCT=0.005
GRID_LEVERAGE=1
GRID_REBALANCE_INTERVAL_SEC=300

# ─── Momentum ─────────────────────────────────────────────────────────
MOMENTUM_ENABLED=false
MOMENTUM_EXCHANGE=bybit
MOMENTUM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT
MOMENTUM_EMA_FAST=9
MOMENTUM_EMA_SLOW=21
MOMENTUM_LEVERAGE=5
MOMENTUM_TIMEFRAME=15
MOMENTUM_STOP_LOSS_PCT=0.02
MOMENTUM_TAKE_PROFIT_PCT=0.04
MOMENTUM_TICK_INTERVAL_SEC=60
MOMENTUM_MAX_POSITIONS=2
MOMENTUM_MIN_ATR_PCT=0.005
MOMENTUM_TRAIL_ACTIVATE_PCT=0.02
MOMENTUM_TRAIL_DISTANCE_PCT=0.01

# ─── Momentum: Mean-Reversion (ADX < 25 = ranging market) ─────────────
MOMENTUM_MR_RSI_OVERSOLD=25
MOMENTUM_MR_RSI_OVERBOUGHT=75
MOMENTUM_MR_SL_PCT=0.015
MOMENTUM_MR_TP_RSI_EXIT=55
MOMENTUM_MR_MAX_HOLD_BARS=20
# 0 = disabled. Volume confirmation (1.2 = require 1.2x avg volume)
MOMENTUM_MR_MIN_VOL_RATIO=0
# 0 = disabled. BB width filter (0.08-0.10 for max safety)
MOMENTUM_MR_MAX_BB_WIDTH=0
# RSI momentum filter: blocks entries when RSI delta > threshold (breakdown protection)
MOMENTUM_MR_RSI_DELTA_THRESHOLD=20

# ─── Momentum: Breakout (ADX >= 50 = strong trend) ────────────────────
MOMENTUM_BO_LOOKBACK=20
MOMENTUM_BO_MIN_VOL_RATIO=1.5
MOMENTUM_BO_SL_PCT=0.02
MOMENTUM_BO_TRAIL_ACTIVATE_PCT=0.015
MOMENTUM_BO_TRAIL_DISTANCE_PCT=0.01
MOMENTUM_BO_MAX_HOLD_BARS=96

# ─── ADX Regime Thresholds ────────────────────────────────────────────
# ADX < 25: mean-reversion mode
MOMENTUM_ADX_RANGE_THRESHOLD=25
# ADX >= 50: breakout mode
MOMENTUM_ADX_TREND_THRESHOLD=50

# ─── Session Filter ───────────────────────────────────────────────────
MOMENTUM_SESSION_FILTER_ENABLED=true
MOMENTUM_SESSION_START_UTC=8
MOMENTUM_SESSION_END_UTC=22

# ─── Macro Calendar Blackout ──────────────────────────────────────────
MACRO_CALENDAR_ENABLED=true
MACRO_BLACKOUT_BEFORE_MIN=30
MACRO_BLACKOUT_AFTER_MIN=60

# ─── Grid: Profit Reinvestment ────────────────────────────────────────
GRID_REINVEST_ENABLED=true
GRID_REINVEST_PCT=0.7

# ─── Risk: Per-strategy Daily Loss ────────────────────────────────────
RISK_DAILY_LOSS_GRID_PCT=0.02
RISK_DAILY_LOSS_MOMENTUM_PCT=0.03

# ─── Kill-switch file fallback ────────────────────────────────────────
# Touch this file to stop the bot even if Telegram is down
KILL_FILE_PATH=/app/data/KILL

# ─── Биржевые ключи ───────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BINANCE_API_KEY=
BINANCE_API_SECRET=

GATE_API_KEY=
GATE_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

HTX_API_KEY=
HTX_API_SECRET=

BINGX_API_KEY=
BINGX_API_SECRET=

# ─── Funding-арб ──────────────────────────────────────────────────────
# 15 altcoins с высокими funding rates. 6 позиций x $150 = $900 notional при $385 capital + 5x leverage
FUNDING_SCAN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT,ARBUSDT,WIFUSDT,PEPEUSDT,AVAXUSDT,SUIUSDT,LINKUSDT,AAVEUSDT,OPUSDT,APTUSDT,NEARUSDT
ARB_MAX_POSITIONS=6
ARB_LEVERAGE=5
ARB_NOTIONAL_USDT=150
ARB_DAILY_LOSS_USDT=30
ARB_WEEKLY_LOSS_USDT=100

# ─── Persistence ──────────────────────────────────────────────────────
TRADES_DB_PATH=/app/data/trades.db
STATE_DB_PATH=/app/data/state.json

# ─── Дашборд ──────────────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
