# =============================================================================
# AI Outbound Agency - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL async connection string (e.g. postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/outbound_sales

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis connection URL for rate limiting, caching, and queues
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI API key
OPENAI_API_KEY=sk-your-openai-key
# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Groq API key for fast inference
GROQ_API_KEY=gsk_your-groq-key
# Apollo.io API key for lead search
APOLLO_API_KEY=your-apollo-api-key
# Hunter.io API key for email verification
HUNTER_API_KEY=your-hunter-api-key

# LLM fallback chain (comma-separated: openai, anthropic, groq)
LLM_FALLBACK_CHAIN=openai
# Model names per provider
LLM_OPENAI_MODEL=gpt-4
LLM_ANTHROPIC_MODEL=claude-3-sonnet-20240229
LLM_GROQ_MODEL=llama3-8b-8192
# Timeout per provider (seconds)
LLM_OPENAI_TIMEOUT=30
LLM_ANTHROPIC_TIMEOUT=45
LLM_GROQ_TIMEOUT=15

# -----------------------------------------------------------------------------
# SMTP (Primary)
# -----------------------------------------------------------------------------
# Primary SMTP server hostname
SMTP_HOST=smtp.example.com
# Primary SMTP server port
SMTP_PORT=587
# Primary SMTP username
SMTP_USER=your-email@example.com
# Primary SMTP password
SMTP_PASSWORD=your-smtp-password
# Multiple SMTP domains (JSON array of domain config objects)
SMTP_DOMAINS=[]

# -----------------------------------------------------------------------------
# IMAP (Inbox Listener)
# -----------------------------------------------------------------------------
# IMAP server hostname for reply detection
IMAP_HOST=
# IMAP server port (default: 993 for SSL)
IMAP_PORT=993
# IMAP username
IMAP_USER=
# IMAP password
IMAP_PASSWORD=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Host to bind the app (default: 0.0.0.0)
APP_HOST=0.0.0.0
# Port to bind the app (default: 8000)
APP_PORT=8000

# -----------------------------------------------------------------------------
# Tracking
# -----------------------------------------------------------------------------
# Base URL for open/click tracking pixels
TRACKING_BASE_URL=http://localhost:8000
# Secret key for HMAC-signed tracking links
TRACKING_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# Calendar Integration
# -----------------------------------------------------------------------------
# Calendar provider (calcom or google)
CALENDAR_PROVIDER=calcom
# Cal.com API key
CALCOM_API_KEY=
# Cal.com base URL
CALCOM_BASE_URL=https://api.cal.com/v1
# Google Calendar credentials JSON (base64-encoded or path)
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Calendly API key
CALENDLY_API_KEY=
# Calendly event type URI
CALENDLY_EVENT_TYPE=
# Google Calendar OAuth2 client ID
GOOGLE_CALENDAR_CLIENT_ID=
# Google Calendar OAuth2 client secret
GOOGLE_CALENDAR_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for JWT token signing (MUST change in production)
JWT_SECRET_KEY=change-me-in-production
# JWT signing algorithm
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
# Stripe secret API key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Stripe publishable key (for frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Voice AI Add-on Stripe Price IDs
# These are created in your Stripe dashboard for each voice plan
STRIPE_VOICE_STARTER_PRICE_ID=price_voice_starter
STRIPE_VOICE_PRO_PRICE_ID=price_voice_pro
STRIPE_VOICE_SCALE_PRICE_ID=price_voice_scale

# -----------------------------------------------------------------------------
# LinkedIn
# -----------------------------------------------------------------------------
# Directory to store LinkedIn session cookies
LINKEDIN_SESSION_DIR=./linkedin_sessions
# Daily limits for LinkedIn actions
LINKEDIN_MAX_CONNECTIONS_PER_DAY=25
LINKEDIN_MAX_MESSAGES_PER_DAY=20
LINKEDIN_MAX_PROFILE_VIEWS_PER_DAY=50
# Minimum cooldown between actions (hours)
LINKEDIN_MIN_ACTION_COOLDOWN_HOURS=2
# Proxy list for LinkedIn (JSON array of proxy URLs)
LINKEDIN_PROXY_LIST=[]
# Enable LinkedIn self-healing for expired sessions
LINKEDIN_SELF_HEALING_ENABLED=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
# Metrics endpoint auth token (leave empty for unauthenticated access)
METRICS_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# ARQ (Async Redis Queue)
# -----------------------------------------------------------------------------
# Redis URL for background job processing
ARQ_REDIS_URL=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=
# Telegram bot token for system notifications
TELEGRAM_BOT_TOKEN=
# Telegram chat ID for system notifications
TELEGRAM_CHAT_ID=
# Client-facing Telegram bot token for report delivery
CLIENT_TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Approval Settings
# -----------------------------------------------------------------------------
# Company size threshold requiring manual approval
APPROVAL_REQUIRED_COMPANY_SIZE=500

# -----------------------------------------------------------------------------
# Auto-Approve Settings
# -----------------------------------------------------------------------------
# Enable auto-approval for qualifying leads
AUTO_APPROVE_ENABLED=false
# Minimum quality score for auto-approval (0-100)
AUTO_APPROVE_QUALITY_THRESHOLD=75
# JSON list of protected company domains (never auto-approve)
PROTECTED_COMPANIES_LIST=[]
# Max retries for auto-approval workflow
AUTO_APPROVE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Dogfooding
# -----------------------------------------------------------------------------
# Enable dogfooding mode (use the system to sell itself)
DOGFOOD_ENABLED=false
# Sending domain for dogfood outreach
DOGFOOD_SENDING_DOMAIN=

# -----------------------------------------------------------------------------
# Health Monitor
# -----------------------------------------------------------------------------
# Interval between health checks (minutes)
HEALTH_CHECK_INTERVAL_MINUTES=5
# Send health alerts via Telegram
HEALTH_TELEGRAM_ALERTS=true

# -----------------------------------------------------------------------------
# Backup Settings
# -----------------------------------------------------------------------------
# Local backup directory
BACKUP_DIR=/backups
# Number of days to retain backups
BACKUP_RETENTION_DAYS=7
# S3-compatible storage for off-site backups
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# -----------------------------------------------------------------------------
# Competitive Intelligence
# -----------------------------------------------------------------------------
# Enable competitive intelligence tracking
COMPETITIVE_INTEL_ENABLED=false
# JSON list of competitor domains to monitor
COMPETITIVE_INTEL_COMPETITORS=[]
