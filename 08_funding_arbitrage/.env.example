# Zenith Funding Arbitrage Bot — шаблон переменных окружения.
# Скопируйте в .env и заполните. .env НИКОГДА не коммитьте.

# ====================================================================
# Telegram (обязательно для запуска)
# ====================================================================
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# ====================================================================
# Режим работы
# ====================================================================
# Включить авто-арбитраж. По умолчанию OFF (только сканирование).
ARB_EXECUTOR_ENABLED=0

# Dry-run (не ставить ордера на биржу).
DRY_RUN=false

# Testnet-биржи (true) или mainnet (false).
IS_TESTNET=true

# ====================================================================
# Биржевые ключи
# Нужны только для бирж, на которых хотим открывать пары. Funding-сканер
# работает на публичных эндпоинтах — без ключей, но и не торгует.
# ====================================================================

# Bybit (V5, Unified)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX (V5)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Binance USDS-M futures
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Gate.io perp
GATE_API_KEY=
GATE_API_SECRET=

# Bitget USDT futures
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# MEXC contract
MEXC_API_KEY=
MEXC_API_SECRET=

# HTX (бывший Huobi)
HTX_API_KEY=
HTX_API_SECRET=

# BingX
BINGX_API_KEY=
BINGX_API_SECRET=

# ====================================================================
# Killswitches
# ====================================================================
# Лимит суточного убытка арб-движка в USDT (0 = выключено).
ARB_DAILY_LOSS_USDT=30

# Лимит недельного убытка в USDT.
ARB_WEEKLY_LOSS_USDT=100

# ====================================================================
# Веб-дашборд (read-only HTTP)
# ====================================================================
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
