# ==============================================================================
# Price Monitor - Environment Variables
# ==============================================================================
# Скопируйте этот файл в .env и заполните значения

# ==============================================================================
# Backend (FastAPI)
# ==============================================================================

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/api.db
POSTGRESQL_URL=postgresql+asyncpg://price_monitor:price_monitor_secret@localhost:5432/price_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT авторизация
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=0

# OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ЮKassa (платежи)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_WEBHOOK_SECRET=

# Sentry (мониторинг ошибок)
SENTRY_DSN=

# Администраторы
ADMIN_TELEGRAM_IDS=

# Прокси
PROXY_LIST_FILE=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Партнерская программа
PARTNER_COMMISSION_PERCENT=5.0

# ==============================================================================
# Bot (Telegram бот)
# ==============================================================================

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHANNEL_ID=0
TELEGRAM_VIP_CHANNEL_ID=0

# Groq API
GROQ_API_KEY=

# Wildberries
WB_API_TOKEN=

# Ozon
OZON_CLIENT_ID=
OZON_API_KEY=

# Партнерские ссылки
AFFILIATE_TAG=

# База данных бота
DB_PATH=data/bot.db

# Интервалы
PARSE_INTERVAL_MINUTES=30
VIP_DELAY_SECONDS=0
FREE_DELAY_SECONDS=1800

# API подключение к backend
API_BASE_URL=http://localhost:8000

# ==============================================================================
# Frontend (Telegram Mini App)
# ==============================================================================

VITE_API_BASE_URL=http://localhost:8000
