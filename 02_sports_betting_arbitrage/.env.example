# Sports Betting Arbitrage - Environment Variables
# Copy to .env and fill in real values.

# The-Odds-API key (https://the-odds-api.com/)
ODDS_API_KEY=your_odds_api_key_here

# Pinnacle API credentials
PINNACLE_USER=your_pinnacle_user
PINNACLE_PASSWORD=your_pinnacle_password

# Betfair API credentials
BETFAIR_APP_KEY=your_betfair_app_key
BETFAIR_SESSION_TOKEN=
BETFAIR_CERT_PATH=
BETFAIR_KEY_PATH=
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password

# Telegram bot for notifications
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Groq AI for analysis
GROQ_API_KEY=your_groq_api_key_here

# NewsAPI for context
NEWS_API_KEY=your_newsapi_key_here
