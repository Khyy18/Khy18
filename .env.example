# AI Text Agency - Environment Variables
# Copy to .env and fill in real values.
# NEVER commit the .env file to the repository.

# Telegram bot token from @BotFather and numeric chat_id of the admin.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Groq AI API key (https://console.groq.com/keys).
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# (optional) Cerebras - backup LLM provider.
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_MODEL=llama-3.3-70b

# (optional) Gemini - last resort LLM provider.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Database URL. Default: SQLite. For prod: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///agency.db

# Redis URL for caching, rate limiting, and task queue. Empty = disabled.
REDIS_URL=redis://localhost:6379/0

# CRM database path (SQLite).
CRM_DB_PATH=crm.db

# S3-compatible backup storage.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_HOUR=3

# Sentry DSN for error tracking. Empty = disabled.
SENTRY_DSN=

# Log format: "json" for production, "console" for development.
LOG_FORMAT=console

# Alerting thresholds.
ALERT_CHECK_INTERVAL_SEC=30
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_LATENCY_P99_THRESHOLD=2.0
ALERT_QUEUE_BACKLOG_THRESHOLD=100

# Redis Sentinel (optional). Format: host1:port1,host2:port2
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379
# REDIS_SENTINEL_MASTER=mymaster

# Health-check server port.
HEALTH_PORT=8080

# Rate limiting.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Lead scoring: auto-respond threshold (0-100).
LEAD_SCORE_AUTO_RESPOND_THRESHOLD=70
LEAD_SCORING_DB_PATH=lead_scoring.db

# Content generation: hour (UTC) for daily auto-generation.
CONTENT_GENERATION_HOUR=10

# Pricing: base multiplier for dynamic pricing.
PRICING_BASE_MULTIPLIER=1.0

# Fraud detection.
FRAUD_SCORE_THRESHOLD=70
FRAUD_DB_PATH=fraud.db
FRAUD_FILTER_ENABLED=false

# Churn prediction: risk threshold for proactive actions.
CHURN_RISK_THRESHOLD=0.7
