# Пример файла окружения для Zenith-Control Ultimate.
# Скопируйте в .env и заполните реальными значениями.
# ВНИМАНИЕ: никогда не коммитьте файл .env в репозиторий.

# Ключ и секрет Bybit (V5, Unified Trading Account).
# Используется, если EXCHANGE=bybit.
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Ключи OKX V5 (демо-счёт и mainnet используют одни и те же ключи;
# переключение через IS_TESTNET в config.py - заголовок x-simulated-trading:1).
# Используется, если EXCHANGE=okx.
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Токен Telegram бота от @BotFather и числовой chat_id владельца.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# API ключ Groq AI (https://console.groq.com/keys). Без привязки карты.
# Используется для ai_regime / ai_macro_sentinel / ai_postmortem / ai_analyst.
# Free tier: 14400 RPD / 30 RPM, модель llama-3.3-70b-versatile по умолчанию.
GROQ_API_KEY=your_groq_api_key_here
# (опционально) переопределить модель Groq.
# GROQ_MODEL=llama-3.3-70b-versatile

# API ключ https://newsapi.org для новостного контекста.
NEWS_API_KEY=your_newsapi_key_here

# Биржа: bybit или okx (демо-счёт через x-simulated-trading: 1).
EXCHANGE=okx

# DRY_RUN: если true, бот считает сигналы и логирует намерения, но НЕ
# отправляет ордера на биржу. Используется для безопасного сбора статистики.
DRY_RUN=false

# AI-veto gate: "off" / "shadow" / "active" (см. README).
# По умолчанию shadow - безопасный режим для наблюдения за решениями gate.
AI_TRADE_GATE_MODE=shadow

# OKX Реал (опционально, если планируете переключение на mainnet).
# При IS_TESTNET=false бот использует эти ключи вместо OKX_API_KEY/_SECRET/_PASSPHRASE.
# Заполнить можно позже через кнопку "🔑 КЛЮЧИ API → OKX Real *" в Telegram,
# без ручного редактирования .env.
# OKX_API_KEY_REAL=your_real_okx_key_here
# OKX_API_SECRET_REAL=your_real_okx_secret_here
# OKX_PASSPHRASE_REAL=your_real_okx_passphrase_here

# Режим торговли: true = OKX Demo, false = OKX Mainnet (РЕАЛЬНЫЕ ДЕНЬГИ).
# По умолчанию true. Переключать через кнопку "🏦 Демо/Реал" в Telegram.
IS_TESTNET=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Multi-Strategy Ensemble: дополнительные LLM-провайдеры (опционально)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Все ключи ниже — БЕСПЛАТНЫЕ free tier (актуально на Май 2026).
# Регистрация суммарно ~10 минут.
# Без них система работает только на Groq → единая точка отказа.
# С ними — failover между провайдерами + специализация моделей.
# Подробности маршрутизации см. NEXT_SESSION_PROMPT_MULTI_STRATEGY.md
# раздел "LLM Budget & Multi-Provider Routing".

# Cerebras Inference (https://cloud.cerebras.ai) — drop-in замена Groq.
# Free: до ~24M токенов/сутки на gpt-oss-120b. OpenAI-совместимые headers,
# квота читается из x-ratelimit-* как у Groq. Используется как primary
# для Regime classifier и backup для AI-Gate.
CEREBRAS_API_KEY=

# Google AI Studio (https://aistudio.google.com) — Gemini-2.5-Flash.
# Free: 1500 RPD, 15 RPM, длинный контекст 1M токенов. Используется для
# Macro-sentinel (анализ FOMC-протоколов и длинных макро-документов).
# Заголовков с лимитами Google НЕ отдаёт — ведём локальный счётчик.
GOOGLE_AI_KEY=

# OpenRouter (https://openrouter.ai) — доступ к 200+ моделям.
# Free: 50 req/сутки, 20 RPM (без оплаты); 1000 req/сутки если внесли
# хотя бы $10 кредитов. Бесплатные модели: DeepSeek-V3, Nemotron, Qwen.
# Используется для Daily Offline Critic и Postmortem (1-7 вызовов/неделю —
# в 50 RPD укладываемся с запасом).
OPENROUTER_API_KEY=

# CryptoPanic (https://cryptopanic.com/developers/api) — crypto-новости.
# Free: 300 req/сутки. Дополняет NEWS_API_KEY качественной crypto-сводкой
# с готовой sentiment-разметкой. Питает AI-Gate и Macro-sentinel.
CRYPTOPANIC_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Опциональные платные сервисы (НЕ нужны для базовой версии)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Glassnode (https://glassnode.com) — on-chain метрики ($30-100/мес).
# Единственный платный сервис, реально дающий quant-edge: exchange flows,
# BTC dominance shifts, supply distribution. Подключать после успешного
# paper trading на демо, если бюджет позволяет.
GLASSNODE_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# УБРАНЫ из Multi-Strategy Ensemble (не работают на free-tier в 2026):
#   - HuggingFace Inference: квоты порезаны до неюзабельного уровня
#   - Together AI: free tier полностью отменён, минимум $5 prepaid
# Их функционал перераспределён: embeddings → локальный sentence-transformers,
# analyst fallback → Gemini, explainer fallback → Gemini.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
